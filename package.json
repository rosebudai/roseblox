{
  "name": "roseblox-game-engine",
  "version": "0.1.0-dev",
  "description": "Javascript game engine.",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./mechanics": "./src/mechanics.js",
    "./rpg": "./src/rpg.js",
    "./visuals": "./src/visuals.js",
    "./rpg-template": "./src/rpgTemplate.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:rpg-ui": "node scripts/check-rpg-ui.mjs",
    "docs": "mkdir -p build/docs && jsdoc -c jsdoc.json",
    "build:all": "npm run build && npm run docs",
    "test:rpg-combat": "node scripts/check-rpg-combat.mjs",
    "test:rpg-interaction": "node scripts/check-rpg-interaction.mjs",
    "test:rpg-bindings": "node scripts/check-rpg-bindings.mjs"
  },
  "keywords": [],
  "author": "mike.liu.dev@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosebudai/roseblox.git"
  },
  "homepage": "https://github.com/rosebudai/roseblox#readme",
  "bugs": {
    "url": "https://github.com/rosebudai/roseblox/issues"
  },
  "peerDependencies": {
    "@dimforge/rapier3d-compat": "0.20.x",
    "camera-controls": "3.1.x",
    "miniplex": "2.0.x",
    "three": "0.184.x || 0.185.x"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "camera-controls": "3.1.2",
    "miniplex": "2.0.0",
    "three": "0.184.0",
    "esbuild": "0.28.2",
    "jsdoc": "4.0.5",
    "@playwright/test": "1.63.0"
  }
}
